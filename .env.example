# ============================================================
# PiyushOS Brain - configuration
# Is file ko .env naam se copy karo:  cp .env.example .env
# ============================================================

# --- NVIDIA NIM API key (https://build.nvidia.com se milta hai) ---
LLM_API_KEY=nvapi-apni-key-yahan-daalo

# --- Model (aapka NVIDIA model) ---
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Test mode: bina API key ke (false = live) ---
LLM_MOCK=false

# --- Screenshot ko AI ko dikhana hai? (model vision support kare to true) ---
VISION_ENABLED=true

# --- Android app me daalna wala token ---
DEVICE_TOKEN=piyush123

# --- Server port ---
PORT=8787
